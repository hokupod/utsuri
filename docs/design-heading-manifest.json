      "sourceTitleJa": "Design principles for reducing cognitive load"
    },
    {
      "number": "5.1",
      "level": 3,
      "parent": "5",
      "order": 13,
      "sourceTitleJa": "Keep the review questions fixed"
    },
    {
      "number": "5.2",
      "level": 3,
      "parent": "5",
      "order": 14,
      "sourceTitleJa": "Three levels of disclosure"
    },
    {
      "number": "5.3",
      "level": 3,
      "parent": "5",
      "order": 15,
      "sourceTitleJa": "Present one decision unit at a time"
    },
    {
      "number": "5.4",
      "level": 3,
      "parent": "5",
      "order": 16,
      "sourceTitleJa": "Support recognition instead of recall"
    },
    {
      "number": "5.5",
      "level": 3,
      "parent": "5",
      "order": 17,
      "sourceTitleJa": "Reduce duplicate explanations"
    },
    {
      "number": "5.6",
      "level": 3,
      "parent": "5",
      "order": 18,
      "sourceTitleJa": "Do not hide uncertainty"
    },
    {
      "number": "5.7",
      "level": 3,
      "parent": "5",
      "order": 19,
      "sourceTitleJa": "Separate “no issue” from “not checked”"
    },
    {
      "number": "5.8",
      "level": 3,
      "parent": "5",
      "order": 20,
      "sourceTitleJa": "Order by required attention"
    },
    {
      "number": "5.9",
      "level": 3,
      "parent": "5",
      "order": 21,
      "sourceTitleJa": "Never communicate state by color alone"
    },
    {
      "number": "5.10",
      "level": 3,
      "parent": "5",
      "order": 22,
      "sourceTitleJa": "Do not enable motion by default"
    },
    {
      "number": "5.11",
      "level": 3,
      "parent": "5",
      "order": 23,
      "sourceTitleJa": "Use review state as external memory"
    },
    {
      "number": "5.12",
      "level": 3,
      "parent": "5",
      "order": 24,
      "sourceTitleJa": "Reduce change blindness"
    },
    {
      "number": "5.13",
      "level": 3,
      "parent": "5",
      "order": 25,
      "sourceTitleJa": "Limit automation bias"
    },
    {
      "number": "5.14",
      "level": 3,
      "parent": "5",
      "order": 26,
      "sourceTitleJa": "Avoid alarm fatigue"
    },
    {
      "number": "5.15",
      "level": 3,
      "parent": "5",
      "order": 27,
      "sourceTitleJa": "Preserve location"
    },
    {
      "number": "5.16",
