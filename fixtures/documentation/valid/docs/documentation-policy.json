{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schemaVersion": 1,
  "canonicalDesign": {
    "path": "docs/design.md",
    "language": "en",
    "languageLabel": "English (canonical)"
  },
  "readmes": [
    {
      "path": "README.md",
      "language": "en",
      "canonical": true,
      "metadata": "<!-- doc-language: en; canonical: true -->"
    },
    {
      "path": "README.ja.md",
      "language": "ja",
      "canonical": false,
      "metadata": "<!-- doc-language: ja; canonical: README.md -->"
    },
    {
      "path": "README.zh-CN.md",
      "language": "zh-CN",
      "canonical": false,
      "metadata": "<!-- doc-language: zh-CN; canonical: README.md -->"
    }
  ],
  "languageSwitcher": "[English](README.md) | [日本語](README.ja.md) | [简体中文](README.zh-CN.md)",
  "requiredSectionMarkers": [
    "product-outcome",
    "availability-requirements",
    "install",
    "first-review",
    "how-it-works",
    "understand-report",
    "security-privacy",
    "troubleshooting-lifecycle",
    "documentation-contributing-license"
  ],
  "syncCommandIds": [
    "codex-marketplace-add",
    "codex-plugin-install",
    "claude-marketplace-add",
    "claude-plugin-install",
    "first-review-prompt",
    "codex-plugin-remove",
    "claude-plugin-disable",
    "claude-plugin-uninstall"
  ],
  "requiredSupportMarker": "<!-- support-contract:macos-linux-windows-unsupported -->",
  "requiredSupportBoundaryText": {
    "en": "Native Windows is unsupported",
    "ja": "native Windows は非対応",
    "zh-CN": "不支持原生 Windows"
  },
  "requiredContributorTarget": "https://github.com/hokupod/utsuri/blob/main/CONTRIBUTING.md",
  "forbiddenReadmeLiterals": [
    "nix develop",
    "scripts/safe-chain.mjs",
    "bun install",
    "bun run check"
  ],
  "forbiddenReadmePatterns": [
    "(?:^|[^0-9])v?\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:$|[^0-9])"
  ],
  "allowedEnglishCjk": {
    "designHtmlLangs": ["ja"],
    "stripMarkdownLinkDestinations": true,
    "readmeExactText": [
      "[English](README.md) | [日本語](README.ja.md) | [简体中文](README.zh-CN.md)"
    ]
  },
  "forbiddenPublicIdentifiers": ["@utsuri/"],
  "diagnostics": {
    "fileMissing": "DOC_FILE_MISSING",
    "languageMetadata": "DOC_LANGUAGE_METADATA",
    "switcherMismatch": "DOC_SWITCHER_MISMATCH",
    "sectionMissing": "DOC_SECTION_MISSING",
    "sectionDuplicate": "DOC_SECTION_DUPLICATE",
    "commandMissing": "DOC_COMMAND_MISSING",
    "commandDrift": "DOC_COMMAND_DRIFT",
    "oldScope": "DOC_OLD_SCOPE",
    "untranslatedCjk": "DOC_UNTRANSLATED_CJK",
    "linkFileMissing": "DOC_LINK_FILE_MISSING",
    "linkFragmentMissing": "DOC_LINK_FRAGMENT_MISSING",
    "developerContent": "DOC_DEVELOPER_CONTENT",
    "releaseVersion": "DOC_RELEASE_VERSION",
    "supportOverclaim": "DOC_SUPPORT_OVERCLAIM",
    "contributorLink": "DOC_CONTRIBUTOR_LINK"
  }
}
