{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices", ":preserveSemverRanges", ":timezone(Asia/Tokyo)"],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "customManagers": [
    {
      "customType": "regex",
      "description": "Safe-chain version pinned with independently reviewed release digests",
      "managerFilePatterns": ["/^toolchain-policy\\.json$/"],
      "matchStrings": ["\"version\": \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""],
      "depNameTemplate": "@aikidosec/safe-chain",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Primary Bun version shared by packageManager, CI, and toolchain policy",
      "managerFilePatterns": ["/^toolchain-policy\\.json$/", "/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "\"ciPrimary\": \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\"",
        "bun: \\[[0-9]+\\.[0-9]+\\.[0-9]+, (?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\\]"
      ],
      "depNameTemplate": "oven-sh/bun",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^bun-v(?<version>[0-9]+\\.[0-9]+\\.[0-9]+)$"
    }
  ],
  "packageRules": [
    {
      "description": "Keep the primary Bun runtime and type definitions in one tested update",
      "groupName": "Bun toolchain",
      "matchPackageNames": ["bun", "oven-sh/bun", "@types/bun"]
    },
    {
      "description": "Node support ranges are changed only with compatibility policy",
      "enabled": false,
      "matchDepTypes": ["engines"]
    }
  ]
}
