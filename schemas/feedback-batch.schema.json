{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://utsu-ri.dev/schemas/feedback-batch/v1",
  "title": "FeedbackBatch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "reportId",
    "origin",
    "items",
    "state",
    "deliveryMode",
    "contextHash",
    "createdAt"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^fb[-:][A-Za-z0-9._:-]+$",
      "maxLength": 256
    },
    "reportId": {
      "type": "string",
      "pattern": "^report[-:][A-Za-z0-9._:-]+$",
      "maxLength": 256
    },
    "origin": { "$ref": "#/$defs/origin" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/item" }
    },
    "state": { "enum": ["draft", "ready", "submitted", "consumed", "answered", "stale"] },
    "deliveryMode": { "enum": ["direct-same-session", "return-to-session", "export-only"] },
    "contextHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "submittedAt": { "type": "string", "format": "date-time" },
    "consumedAt": { "type": "string", "format": "date-time" },
    "answeredAt": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": { "properties": { "state": { "const": "submitted" } } },
      "then": { "required": ["submittedAt"] }
    },
    {
      "if": { "properties": { "state": { "const": "consumed" } } },
      "then": { "required": ["consumedAt"] }
    },
    {
      "if": { "properties": { "state": { "const": "answered" } } },
      "then": { "required": ["answeredAt"] }
    },
    {
      "if": { "properties": { "deliveryMode": { "const": "direct-same-session" } } },
      "then": {
        "properties": {
          "origin": { "properties": { "bindingMode": { "const": "direct-same-session" } } }
        }
      }
    },
    {
      "if": { "properties": { "deliveryMode": { "const": "return-to-session" } } },
      "then": {
        "properties": {
          "origin": {
            "properties": {
              "bindingMode": { "enum": ["return-to-session", "direct-same-session"] }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "projectFingerprint", "reportId", "bindingMode", "createdAt"],
      "properties": {
        "host": { "enum": ["codex", "claude-code", "unknown"] },
        "sessionRef": { "type": "string", "pattern": "^session:[a-f0-9]{64}$" },
        "projectFingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "reportId": {
          "type": "string",
          "pattern": "^report[-:][A-Za-z0-9._:-]+$",
          "maxLength": 256
        },
        "bindingMode": { "enum": ["direct-same-session", "return-to-session", "unbound"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "bindingMode": { "const": "unbound" } } },
          "then": { "not": { "required": ["sessionRef"] } },
          "else": { "required": ["sessionRef"] }
        },
        {
          "if": { "properties": { "host": { "const": "unknown" } } },
          "then": { "properties": { "bindingMode": { "const": "unbound" } } }
        }
      ]
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref", "fingerprint"],
      "properties": {
        "type": {
          "enum": [
            "change",
            "file",
            "hunk",
            "line-range",
            "visual-target",
            "visual-region",
            "finding",
            "verification-gap"
          ]
        },
        "ref": { "type": "string" },
        "path": { "type": "string" },
        "side": { "enum": ["before", "after", "diff"] },
        "startLine": { "type": "integer", "minimum": 1 },
        "endLine": { "type": "integer", "minimum": 1 },
        "targetRef": { "type": "string" },
        "region": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "width", "height"],
          "properties": {
            "x": { "type": "number", "minimum": 0, "maximum": 1 },
            "y": { "type": "number", "minimum": 0, "maximum": 1 },
            "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        },
        "selectorHint": { "type": "string" },
        "fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "threadId",
        "anchor",
        "sourceMessageId",
        "requestKind",
        "question",
        "contextSelection",
        "state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^item[-:][A-Za-z0-9._:-]+$",
          "maxLength": 256
        },
        "threadId": {
          "type": "string",
          "pattern": "^thread[-:][A-Za-z0-9._:-]+$",
          "maxLength": 256
        },
        "anchor": { "$ref": "#/$defs/anchor" },
        "sourceMessageId": {
          "type": "string",
          "pattern": "^message[-:][A-Za-z0-9._:-]+$",
          "maxLength": 256
        },
        "requestKind": {
          "enum": [
            "explain",
            "trace-impact",
            "risk-check",
            "intent-check",
            "a11y-check",
            "suggest-tests",
            "freeform"
          ]
        },
        "question": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "contextSelection": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "includeCodeDiff",
            "includeVisualCrop",
            "includeComputedStyle",
            "includeDomAria",
            "includeRelatedTests"
          ],
          "properties": {
            "includeCodeDiff": { "type": "boolean" },
            "includeVisualCrop": { "type": "boolean" },
            "includeComputedStyle": { "type": "boolean" },
            "includeDomAria": { "type": "boolean" },
            "includeRelatedTests": { "type": "boolean" }
          }
        },
        "state": { "enum": ["ready", "submitted", "acknowledged", "answered", "stale"] }
      }
    }
  }
}
