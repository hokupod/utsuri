{
  "name": "utsuri-workspace",
  "version": "0.3.2",
  "private": true,
  "description": "Evidence-backed visual change review for Codex and Claude Code",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "safe": "node scripts/safe-chain.mjs",
    "dev:env": "node scripts/dev-env-check.mjs --json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 --ignore-pattern '.svelte-check/**'",
    "typecheck": "tsc --noEmit && svelte-check --tsgo --tsconfig ./tsconfig.json",
    "schemas:generate": "node scripts/generate-schemas.mjs",
    "schemas:check": "node scripts/generate-schemas.mjs --check && node scripts/validate-schemas.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "docs:check:test": "node --test tests/documentation/docs-check.test.mjs",
    "test": "node scripts/run-test-files.mjs all",
    "test:integration": "node scripts/run-test-files.mjs integration",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:security": "node scripts/run-test-files.mjs security",
    "test:a11y": "playwright test --project=a11y",
    "native:build": "node scripts/build-native-helper.mjs",
    "verify:native-cli-json": "node scripts/verify-native-cli-json.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "validate:fixtures": "node scripts/validate-fixtures.mjs",
    "fixtures:refresh-report-assets": "node scripts/refresh-report-fixture-assets.mjs",
    "verify:release-layout": "node scripts/verify-release-layout.mjs",
    "verify:sbom": "node scripts/verify-sbom.mjs",
    "plugin:verify": "node scripts/verify-plugin.mjs",
    "plugin:runtime:verify": "node scripts/plugin-runtime-probe.mjs --local-e2e",
    "plugin:promote": "node scripts/plugin-promote.mjs",
    "supply-chain:baseline": "node scripts/generate-dependency-baseline.mjs",
    "deps:refresh": "node scripts/generate-schemas.mjs && node scripts/generate-dependency-baseline.mjs && node scripts/build.mjs && node scripts/refresh-report-fixture-assets.mjs && node scripts/validate-fixtures.mjs",
    "eval:skills": "node scripts/eval-skills.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "axe-core": "4.13.0",
    "fflate": "0.8.3",
    "pixelmatch": "7.2.0",
    "playwright-core": "1.62.1",
    "pngjs": "7.0.0",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.62.1",
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@types/bun": "1.4.0",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.11.0",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.10",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "7.3.6"
  }
}
