{
  "name": "utsuri-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-backed visual change review for Codex and Claude Code",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "packages/adapters/*"
  ],
  "scripts": {
    "safe": "node scripts/safe-chain.mjs",
    "dev:env": "node scripts/dev-env-check.mjs --json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "schemas:generate": "node scripts/generate-schemas.mjs",
    "schemas:check": "node scripts/generate-schemas.mjs --check && node scripts/validate-schemas.mjs",
    "docs:check": "node scripts/docs-check.mjs --mode development",
    "docs:check:test": "node --test tests/documentation/docs-check.test.mjs",
    "docs:check:release": "node scripts/docs-check.mjs --mode release-candidate",
    "test": "bun test --parallel=1 --path-ignore-patterns 'tests/e2e/**'",
    "test:integration": "bun test tests/integration",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:security": "bun test tests/security",
    "test:a11y": "playwright test --project=a11y",
    "native:build": "node scripts/build-native-helper.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "validate:fixtures": "node scripts/validate-fixtures.mjs",
    "verify:release-layout": "node scripts/verify-release-layout.mjs",
    "verify:sbom": "node scripts/verify-sbom.mjs",
    "eval:skills": "node scripts/eval-skills.mjs"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "axe-core": "4.10.3",
    "fflate": "0.8.2",
    "pixelmatch": "7.1.0",
    "playwright-core": "1.55.0",
    "pngjs": "7.0.0",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.55.0",
    "@sveltejs/vite-plugin-svelte": "6.1.1",
    "@types/bun": "1.3.14",
    "@types/node": "24.3.0",
    "esbuild": "0.25.10",
    "eslint": "9.35.0",
    "eslint-plugin-svelte": "3.12.2",
    "globals": "16.3.0",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "3.4.0",
    "svelte": "5.56.8",
    "svelte-check": "4.3.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.43.0",
    "vite": "7.1.7"
  }
}
