{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://utsu-ri.dev/schemas/annotations/v1",
  "title": "Annotations",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "language", "overview", "changes"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "verificationResults": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/verificationResult"
      }
    },
    "overview": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "changes": { "type": "array", "items": { "$ref": "#/$defs/semanticChange" } }
  },
  "$defs": {
    "verificationResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "environment",
        "command",
        "subjectSha",
        "exitCode",
        "passedCount",
        "warnings",
        "changeRefs",
        "completedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^verification[-:][A-Za-z0-9._:-]+$",
          "maxLength": 128
        },
        "kind": {
          "enum": ["unit-tests", "typecheck", "lint", "build", "app-e2e", "external-service"]
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 2048
          }
        },
        "subjectSha": {
          "type": ["string", "null"],
          "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
        },
        "exitCode": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 255
        },
        "passedCount": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "warnings": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "changeRefs": {
          "type": "array",
          "maxItems": 1000,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^change[-:]"
          }
        },
        "completedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "logRef": {
          "type": "string",
          "pattern": "^verification/[A-Za-z0-9][A-Za-z0-9._/-]*\\.(?:txt|log|ndjson)$",
          "maxLength": 500
        },
        "logSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "dependencies": {
        "logRef": ["logSha256"],
        "logSha256": ["logRef"]
      }
    },
    "semanticChange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "kind",
        "summary",
        "intent",
        "implementation",
        "userImpact",
        "technicalImpact",
        "risk",
        "hunkRefs",
        "hunkExplanations",
        "targetRefs",
        "findingRefs",
        "verification"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^change[-:]" },
        "title": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["visual", "behavior", "content", "accessibility", "refactor", "mixed", "unknown"]
        },
        "summary": { "type": "string" },
        "intent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "source", "evidenceRefs"],
          "properties": {
            "text": { "type": "string" },
            "source": { "enum": ["declared", "supported-inference", "weak-inference", "unknown"] },
            "evidenceRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "missingEvidence": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        },
        "implementation": { "type": "string" },
        "userImpact": { "type": "array", "items": { "type": "string" } },
        "technicalImpact": { "type": "array", "items": { "type": "string" } },
        "risk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "reasons"],
          "properties": {
            "level": { "enum": ["critical", "high", "medium", "low", "info"] },
            "reasons": { "type": "array", "items": { "type": "string" } }
          }
        },
        "hunkRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "hunkExplanations": {
          "type": "array",
          "items": { "$ref": "#/$defs/hunkExplanation" }
        },
        "targetRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "findingRefs": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["verified", "gaps"],
          "properties": {
            "verified": { "type": "array", "items": { "type": "string" } },
            "gaps": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "hunkExplanation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hunkRef", "purpose", "meaning"],
      "properties": {
        "hunkRef": { "type": "string", "pattern": "^hunk:" },
        "purpose": { "type": "string", "minLength": 1, "maxLength": 160 },
        "meaning": { "type": "string", "minLength": 1, "maxLength": 320 }
      }
    }
  }
}
